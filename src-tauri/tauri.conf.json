{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Capsule LAN",
  "version": "0.7.10",
  "identifier": "com.capsuletransfer.app",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm run dev --prefix ../webapp",
    "frontendDist": "../webapp/dist",
    "devUrl": "http://localhost:3100"
  },
  "app": {
    "windows": [
      {
        "title": "Capsule LAN",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  },
  "plugins": {}
}
